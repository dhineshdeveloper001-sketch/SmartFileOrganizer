# Database Configuration (Neon PostgreSQL)
# Connection pooling URL (recommended for serverless/Next.js)
DATABASE_URL="postgresql://neondb_owner:<password>@ep-<project>-pooler.<region>.aws.neon.tech/neondb?sslmode=require"
# Direct connection URL (used for migrations if needed)
DIRECT_URL="postgresql://neondb_owner:<password>@ep-<project>.<region>.aws.neon.tech/neondb?sslmode=require"

# Authentication
# Run `openssl rand -base64 32` or provide a 32+ character random string
AUTH_SECRET="your-32-character-secret-key-goes-here-change-in-production"
AUTH_EXPIRES_IN="7d"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloud Object Storage (S3 / Cloudflare R2 / MinIO)
# Optional: if left blank, falls back to secure server-side storage in ./uploads
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="smart-file-organizer"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_DOMAIN=""

# Quota Settings (in bytes, default 500MB = 524288000)
MAX_USER_STORAGE_BYTES="524288000"
MAX_FILE_SIZE_BYTES="524288000"
